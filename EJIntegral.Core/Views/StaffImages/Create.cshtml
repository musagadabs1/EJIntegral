@model EJIntegral.Core.Models.Legacy.StaffImage
@{
    ViewData["Title"] = "Capture Staff Photo";
}

<h2>Capture Staff Photo</h2>

<form asp-action="Create" asp-controller="StaffImages" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6">
            <img src="~/Content/man-user.png" id="output" width="180" height="180" class="mb-3 border" />
            <input type="file" name="file" accept="image/*" onchange="openFile(event)" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Save Staff Photo</button>
</form>

@section Scripts {
    <script>
        const openFile = function (event) {
            const input = event.target;
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById("output").src = reader.result;
            };
            reader.readAsDataURL(input.files[0]);
        };
    </script>
}
