@model IEnumerable<EJIntegral.Core.Models.Legacy.EmployeeInfoWithPhoto>
@{
    ViewData["Title"] = "Staff List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Staff Dashboard</h2>
    <a class="btn btn-primary" asp-controller="Staff_Details" asp-action="Create">New Staff Registration</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Staff ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Contact</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr>
            <td>@row.StaffId</td>
            <td>@row.Fullname</td>
            <td>@row.DepartmentName</td>
            <td>@row.CurrentDesignation</td>
            <td>@row.ContactNumber</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Biometric" asp-action="Index" asp-route-staffId="@row.StaffId">Biometric</a>
            </td>
        </tr>
    }
    </tbody>
</table>
